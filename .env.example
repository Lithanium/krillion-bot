# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: channel ID where the daily leaderboard is posted.
# If empty, it is posted to the channel where that day's results were shared.
LEADERBOARD_CHANNEL_ID=

# Optional: only read results from this channel (empty = every channel the bot can see)
RESULTS_CHANNEL_ID=

# Path to the SQLite database
DATABASE_PATH=data/krillion.sqlite3

# Minutes after the daily reset during which the previous puzzle is still accepted
# (the leaderboard + rating update is posted once this grace period ends).
LATE_GRACE_MINUTES=10

# Queens-bot / Codeforces-style rating (see README). Damping scales each
# day's raw contest delta; decay pulls resting divers back towards 1200.
RATING_DAMPING=0.25
RATING_DECAY_BASE=0.04
RATING_DECAY_MAX=0.08
RATING_DECAY_GRACE=0

# Discord user IDs (comma-separated) allowed to run admin commands such as /invalidate
ADMIN_USER_IDS=750888871696269402

# Krillion puzzle calendar. The game rolls over at midnight America/New_York
# (= 2pm AEST while the US is on daylight time), puzzle #1 was 2026-07-16.
KRILLION_TIMEZONE=America/New_York
KRILLION_EPOCH_DATE=2026-07-16

# Log level
LOG_LEVEL=INFO
